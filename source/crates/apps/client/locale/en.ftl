# The engine's own messages, which no package gives: the window's title at the match's end.
match-victory = Campfire: victory
match-defeat = Campfire: defeat
match-ended = Campfire: the match ended
# The command panel's commands (02-engine-core.md, The panel's commands are the engine's orders).
command-sell = Sell
command-stop = Stop
command-attack-move = Attack move
command-rally = Set rally point
command-exit = Exit
command-evacuate = Evacuate
# The panels' values: a time, a cast's cooldown, a research held, a player's rank and points, and
# a perk held.
time-seconds = { $seconds } s
button-ready = ready in { $seconds } s
button-done = done
perk-rank = rank { $level } · { $xp } xp
perk-points = { $points } points
perk-held = held
