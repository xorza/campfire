# Package files are hashed byte for byte, so their fingerprints, and every session that names
# them, must see the same bytes on every OS: text stays LF on checkout everywhere.
* text=auto eol=lf
# A package index is text of LF lines, which no checkout may change, or its hash, the package's
# fingerprint, would.
package.index text eol=lf
# A pinned session log is binary: a changed line ending would fail its format's pin.
source/crates/session/protocol/tests/golden/session-log/* binary
